{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goliath-Research/GoliathExtractor/blob/main/.goliath/product.schema.json",
  "title": "Product summary",
  "description": "Machine-readable product summary for the GoliathWeb site (Goliath Research Inc.). dependsOn is an optional array of upstream product ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "tagline",
    "description",
    "category",
    "features",
    "links",
    "related",
    "license",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Schema generation. This document is version 1.",
      "const": 1
    },
    "id": {
      "description": "Stable product id used by the site and by dependsOn / related entries.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "Short markdown description, two to four sentences.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Catalog category. GoliathExtractor is a component.",
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "docs", "website"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "website": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "related": {
      "description": "Ids of related products. Empty when none are declared.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "dependsOn": {
      "description": "Optional array of upstream product ids. Omit the property, or use an empty array, when this product does not depend on another catalog product.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
